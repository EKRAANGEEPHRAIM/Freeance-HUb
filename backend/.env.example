# Copier ce fichier en .env et remplir les valeurs.

# Chaîne de connexion fournie par Neon (poolée). L'URL directe pour les
# migrations en est déduite automatiquement (voir prisma.config.ts).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Au moins 32 caractères aléatoires (ex. : openssl rand -hex 32)
JWT_SECRET=

PORT=3000
FRONTEND_URL=http://localhost:4200
NODE_ENV=development
